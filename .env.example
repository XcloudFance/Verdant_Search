# ============================================================
#  Verdant Search — Environment Variables
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ============================================================

# ── Database (matches docker-compose.yml defaults) ───────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=verdant
DB_PASS=verdant123
DB_NAME=verdant_search
DATABASE_URL=postgresql+asyncpg://verdant:verdant123@localhost:5432/verdant_search

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Go Backend ───────────────────────────────────────────────
PORT=8080
JWT_SECRET=change-this-to-a-long-random-string

# ── LLM Provider: "anthropic" or "openai" ────────────────────
LLM_PROVIDER=anthropic

# Anthropic (recommended)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (optional fallback)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Search Parameters ────────────────────────────────────────
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
TOP_K_RESULTS=20

# ── Embedding Model (downloads on first run, ~500MB) ─────────
EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32
EMBEDDING_DIM=512

# ── Cache ────────────────────────────────────────────────────
CACHE_TTL=600
ENABLE_CACHE=true
