# ============================================================
#  Verdant Search — Frontend environment variables (Vite)
#  Copy to frontend/.env and fill in your server address.
#
#  Local development (default — no .env needed):
#    VITE_PYTHON_API_URL=http://localhost:8001
#    VITE_GO_API_URL=http://localhost:8080
#
#  Remote server (replace with your IP or domain):
#    VITE_PYTHON_API_URL=http://192.168.1.100:8001
#    VITE_GO_API_URL=http://192.168.1.100:8080
# ============================================================

VITE_PYTHON_API_URL=http://localhost:8001
VITE_GO_API_URL=http://localhost:8080
